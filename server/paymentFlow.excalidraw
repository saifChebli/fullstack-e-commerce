      "updated": 1765016703263,
      "link": null,
      "locked": false,
      "text": "1 - User creates an order in our e-commerce platform\n2 - User clicks \"Pay\"\n3 - We call backend => creates a Checkout session\n4 - Backend returns a URL\n5 - Frontend redirects user to Stripe page\n6 - Stripe redirects back to our site (success / fail )\n7 - Webhook marks the order as paid",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 - User creates an order in our e-commerce platform\n2 - User clicks \"Pay\"\n3 - We call backend => creates a Checkout session\n4 - Backend returns a URL\n5 - Frontend redirects user to Stripe page\n6 - Stripe redirects back to our site (success / fail )\n7 - Webhook marks the order as paid",
      "autoResize": true,
      "lineHeight": 1.25
    },
